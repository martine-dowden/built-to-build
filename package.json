{
  "name": "built-to-build",
  "version": "1.0.0",
  "description": "Demo CLI for Martine's talk Built to Build",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "forge": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsc -p tsconfig.build.json -w",
    "lint": "pnpm biome check",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "forge": "node --env-file=.env ./dist/index.js",
    "forge:local": "node --env-file=.env.local ./dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "docs": "pnpm run build && pnpm run forge docs"
  },
  "keywords": ["cli", "typescript", "commander", "ux", "automation", "CI/CD"],
  "author": "Martine Dowden",
  "license": "BSD-3-Clause",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.9.0",
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/inquirer": "^9.0.10",
    "@types/node": "^26.6.4",
    "firebase-tools": "^15.33.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.3",
    "colors": "^1.4.0",
    "commander": "^15.0.0",
    "firebase-admin": "^14.5.0",
    "inquirer": "^14.2.3"
  },
  "files": ["dist"],
  "sideEffects": false
}
